generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  SOCIAL_WORKER
  CAREGIVER
  VOLUNTEER
  FINANCE
  LOGISTICS
}

enum ChildStatus {
  ACTIVE
  REINTEGRATED
  GRADUATED
}

enum OrphanStatus {
  YATIM
  PIATU
  YATIM_PIATU
  KELUARGA_RETAK
  KELUARGA_MISKIN
}

enum EducationLevel {
  BELUM_SEKOLAH
  PAUD_TK
  SD
  SMP
  SMA_SMK
  PERGURUAN_TINGGI
}

enum Religion {
  ISLAM
  KRISTEN
  KATOLIK
  HINDU
  BUDDHA
  KHONGHUCU
}

enum Occupation {
  TIDAK_BEKERJA
  BURUH_PABRIK
  NELAYAN
  PETANI
  BURUH_BANGUNAN
  BURUH_HARIAN
  SUPIR_KENEK
  PELAUT
  PEDAGANG
  PRT
  TKI
  ASN
  LAINNYA
}

enum ParentStatus {
  HIDUP
  MENINGGAL
  TIDAK_DIKETAHUI
  BEKERJA_JAUH
  PROSES_HUKUM
}

enum ResidenceStatus {
  MILIK_SENDIRI
  SEWA
  MENUMPANG
  TIDAK_MEMILIKI
}

enum SpouseStatus {
  ISTRI
  SUAMI
  BERCERAI
}

enum EmploymentStatus {
  TETAP
  KONTRAK
  HARIAN
}

enum HomeLeaveReason {
  LIBURAN_SEKOLAH
  LIBURAN_HARI_RAYA
  ORANG_TUA_SAKIT
  SAKIT
  SKORSING
}

enum HomeLeaveReturnStatus {
  BELUM_KEMBALI
  TEPAT_WAKTU
  LEBIH_CEPAT
  TERLAMBAT
}

// Kunjungan orang tua/wali ke panti (buku tamu keluarga)
model FamilyVisit {
  id           String   @id @default(cuid())
  childId      String
  visitorName  String
  relationship String?
  visitDate    DateTime
  purpose      String
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  child     Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([childId])
  @@index([visitDate])
}

model HomeLeave {
  id                String                @id @default(cuid())
  childId           String
  leaveDate         DateTime
  // Rencana tanggal kembali (diisi saat pencatatan)
  plannedReturnDate DateTime?
  // Tanggal aktual anak tiba kembali di panti
  actualReturnDate  DateTime?
  // Dihitung otomatis dari perbandingan rencana vs aktual
  returnStatus      HomeLeaveReturnStatus @default(BELUM_KEMBALI)
  reason            HomeLeaveReason
  description       String?
  createdById       String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  child     Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([childId])
  @@index([leaveDate])
  @@index([returnStatus])
}

enum SiblingActivity {
  SEKOLAH
  BEKERJA
  BELUM_SEKOLAH
  TIDAK_BEKERJA
}

enum SiblingLivingWith {
  ORANG_TUA
  WALI
  KELUARGA
  PANTI_ASUHAN
}

enum SiblingRelation {
  KAKAK
  ADIK
}

enum SleepQuality {
  GOOD
  FAIR
  POOR
}

enum SchoolAttendance {
  HADIR
  BOLOS
  IZIN
  SAKIT
}

enum DonationType {
  CASH
  TRANSFER
  IN_KIND
}

enum DonorType {
  PERORANGAN
  PERUSAHAAN
}

enum DonationCategory {
  ZAKAT_MAAL
  ZAKAT_FITRAH
  INFAQ_SEDEKAH
  WAKAF_TUNAI
  WAKAF_ASET
  HIBAH_TERIKAT
  QURBAN
}

enum DonationItemUnit {
  PCS
  KG
  LTR
  BOX
}

enum VolunteerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PartnerType {
  RS
  SEKOLAH
  POLISI
  CSR
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
}

enum CaseType {
  PROTECTION
  HEALTH
  EDUCATION
  PSYCHOSOCIAL
  LEGAL
  FAMILY_REUNIFICATION
  OTHER
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum VisitStatus {
  PLANNED
  DONE
  CANCELLED
}

enum ShiftType {
  PAGI
  SIANG
  MALAM
}

enum IncidentType {
  HEALTH
  BEHAVIOR
  ACCIDENT
  OTHER
}

enum IncidentUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum InventoryCategory {
  MAKANAN
  ATK
  OBAT
  PERLENGKAPAN
  LAINNYA
}

enum PRStatus {
  PENDING
  APPROVED
  REJECTED
  ORDERED
  RECEIVED
}

enum AssetCategory {
  KENDARAAN
  ELEKTRONIK
  FURNITUR
  BANGUNAN
  LAINNYA
}

enum AssetCondition {
  BAIK
  PERLU_PERBAIKAN
  RUSAK
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(CAREGIVER)
  isActive  Boolean  @default(true)
  phone     String?
  photoUrl  String?
  createdAt DateTime @default(now())

  dailyLogs         DailyLog[]
  auditLogs         AuditLog[]
  assignedCases     Case[]             @relation("AssignedCases")
  interventions     CaseIntervention[]
  caseNotes         CaseNote[]
  caseDocuments     CaseDocument[]
  assignedChildren  Child[]            @relation("CaregiverChildren")
  homeVisits        HomeVisit[]        @relation("VisitCreator")
  officerVisits     HomeVisit[]        @relation("VisitOfficer")
  shiftHandovers    ShiftHandover[]
  reportedIncidents Incident[]
  incidentUpdates   IncidentUpdate[]
  transactions      Transaction[]
  stockAdjustments  StockAdjustment[]
  requestedPRs      PurchaseRequest[] @relation("RequestedPRs")
  decidedPRs        PurchaseRequest[] @relation("DecidedPRs")
  maintenances      AssetMaintenance[]
  notifications     Notification[]
  homeLeaves        HomeLeave[]
  familyVisits      FamilyVisit[]
  picPrograms       Program[]          @relation("ProgramPic")
  createdIncomes    FinanceIncome[]    @relation("IncomeCreator")
  createdExpenses   FinanceExpense[]   @relation("ExpenseCreator")
  reviewedExpenses  FinanceExpense[]   @relation("ExpenseReviewer")
  approvedExpenses  FinanceExpense[]   @relation("ExpenseApprover")
  employee          Employee?
}

model Guardian {
  id                  String   @id @default(cuid())
  name                String
  phone               String?
  address             String?
  relationship        String?
  vulnerabilityScore  Int      @default(0)
  notes               String?
  // Data lengkap wali (Modul Wali)
  nik                 String?
  kkNumber            String?
  dob                 DateTime?
  religion            Religion?
  occupation          Occupation?
  lastEducation       EducationLevel?
  residenceStatus     ResidenceStatus?
  monthlyIncome       Float?
  dependentsCount     Int?
  // Data pasangan wali
  spouseName          String?
  spouseStatus        SpouseStatus?
  spouseNik           String?
  ktpDocUrl           String?
  kkDocUrl            String?
  selfieUrl           String?
  otherDocUrl         String?
  createdAt           DateTime @default(now())

  children Child[]
}

model Child {
  id                  String      @id @default(cuid())
  fullName            String
  nik                 String?
  dob                 DateTime
  gender              String
  religion            Religion?
  bloodType           String?
  heightCm            Float?
  weightKg            Float?
  admissionDate       DateTime    @default(now())
  admissionReason     String?
  status              ChildStatus @default(ACTIVE)
  orphanStatus        OrphanStatus?
  homeAddress         String?
  fatherName          String?
  fatherNik           String?
  fatherReligion      Religion?
  fatherOccupation    Occupation?
  fatherStatus        ParentStatus?
  motherName          String?
  motherNik           String?
  motherReligion      Religion?
  motherOccupation    Occupation?
  motherStatus        ParentStatus?
  lastEducation       EducationLevel?
  lastGrade           String?
  previousSchool      String?
  achievements        String?
  medicalHistory      String?
  notes               String?
  birthOrder          Int?
  siblingsCount       Int?
  photoUrl            String?
  // Dokumen pendukung (URL Cloudinary)
  ijazahUrl           String?
  aktaLahirUrl        String?
  consentUrl          String?
  supportingDocUrl    String?
  otherDocUrl         String?
  guardianId          String?
  assignedCaregiverId String?
  createdAt           DateTime    @default(now())

  guardian          Guardian?   @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  assignedCaregiver User?       @relation("CaregiverChildren", fields: [assignedCaregiverId], references: [id], onDelete: SetNull)
  dailyLogs         DailyLog[]
  cases             Case[]
  homeVisits        HomeVisit[]
  incidents         Incident[]
  siblings          ChildSibling[]
  homeLeaves        HomeLeave[]
  familyVisits      FamilyVisit[]
  expenseBenefits   FinanceExpense[]
}

model ChildSibling {
  id         String             @id @default(cuid())
  childId    String
  name       String
  gender     String?
  dob        DateTime?
  activity   SiblingActivity?
  livingWith SiblingLivingWith?
  pantiName  String?
  relation   SiblingRelation?
  createdAt  DateTime           @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
}

model DailyLog {
  id             String       @id @default(cuid())
  childId        String
  date           DateTime     @default(now())
  moodScore      Int          @default(3)
  // Porsi makan: dihitung otomatis dari 3 waktu makan (habis semua = 100%)
  mealPercentage Int          @default(0)
  breakfastDone  Boolean      @default(false)
  lunchDone      Boolean      @default(false)
  dinnerDone     Boolean      @default(false)
  sleepQuality   SleepQuality @default(GOOD)
  // Sholat 5 waktu
  prayerSubuh    Boolean      @default(false)
  prayerDzuhur   Boolean      @default(false)
  prayerAshar    Boolean      @default(false)
  prayerMaghrib  Boolean      @default(false)
  prayerIsya     Boolean      @default(false)
  piketDone      Boolean      @default(false)
  schoolAttendance SchoolAttendance?
  evaluationNotes String?
  caregiverId    String
  createdAt      DateTime     @default(now())

  child     Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  caregiver User  @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([caregiverId])
  @@index([date])
}

model Donation {
  id             String       @id @default(cuid())
  donaturName    String
  donorType      DonorType    @default(PERORANGAN)
  donaturContact String?
  donaturAddress String?
  amount         Decimal
  type           DonationType @default(CASH)
  category       DonationCategory?
  purpose        String?
  receiptNumber  String       @unique
  receiptPdfUrl  String?
  createdAt      DateTime     @default(now())

  items DonationItem[]

  @@index([createdAt])
}

model DonationItem {
  id          String           @id @default(cuid())
  donationId  String
  itemName    String
  quantity    Int
  unit        DonationItemUnit @default(PCS)
  inventoryId String?
  createdAt   DateTime         @default(now())

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@index([donationId])
}

model Employee {
  id               String           @id @default(cuid())
  // Data Pribadi
  firstName        String
  lastName         String?
  gender           String
  dob              DateTime?
  nik              String?
  religion         Religion?
  phone            String?
  email            String?
  // Kepegawaian
  employeeCode     String           @unique
  joinDate         DateTime?
  department       String?
  position         String?
  grade            String?
  employmentStatus EmploymentStatus @default(TETAP)
  ptkpStatus       String?
  entityLocation   String?
  // Gaji & Pajak
  basicSalary      Float?
  salaryEffectiveDate DateTime?
  npwp             String?
  // Alamat
  fullAddress      String?
  city             String?
  province         String?
  postalCode       String?
  // Akun login yang tertaut (1 pegawai : 1 user)
  userId           String?          @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([employeeCode])
  @@index([department])
}

model Inventory {
  id        String            @id @default(cuid())
  itemName  String
  category  InventoryCategory @default(LAINNYA)
  quantity  Int               @default(0)
  unit      String            @default("pcs")
  minStock  Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  adjustments      StockAdjustment[]
  purchaseRequests PurchaseRequest[]
}

model Volunteer {
  id                  String          @id @default(cuid())
  name                String
  phone               String?
  skill               String?
  status              VolunteerStatus @default(PENDING)
  hasSafeguardingCert Boolean         @default(false)
  redFlagNotes        String?
  // Data pendaftaran publik (Phase 7 Batch 5)
  email               String?
  dob                 DateTime?
  address             String?
  occupation          String?
  availability        String?
  motivation          String?
  ktpUrl              String?
  skckUrl             String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([status])
}

model Partner {
  id            String      @id @default(cuid())
  name          String
  type          PartnerType
  picName       String?
  picPhone      String?
  mouExpiryDate DateTime?
  createdAt     DateTime    @default(now())

  @@index([mouExpiryDate])
}

model SystemConfig {
  id          String   @id @default(cuid())
  configKey   String   @unique
  configValue String
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  userName  String
  action    AuditAction
  entity    String
  entityId  String?
  detail    String?
  ipAddress String?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([action])
}

model Case {
  id           String       @id @default(cuid())
  childId      String
  caseType     CaseType
  description  String
  handling     String?
  priority     CasePriority @default(MEDIUM)
  status       CaseStatus   @default(OPEN)
  assignedToId String
  closedAt     DateTime?
  closeReason  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  child         Child              @relation(fields: [childId], references: [id], onDelete: Cascade)
  assignedTo    User               @relation("AssignedCases", fields: [assignedToId], references: [id])
  interventions CaseIntervention[]
  notes         CaseNote[]
  documents     CaseDocument[]

  @@index([childId])
  @@index([status])
  @@index([assignedToId])
}

model CaseIntervention {
  id               String   @id @default(cuid())
  caseId           String
  date             DateTime @default(now())
  interventionType String
  notes            String
  attachmentUrl    String?
  createdById      String
  createdAt        DateTime @default(now())

  case      Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([caseId])
}

model CaseNote {
  id        String   @id @default(cuid())
  caseId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  case   Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([caseId])
}

model CaseDocument {
  id           String   @id @default(cuid())
  caseId       String
  fileName     String
  fileUrl      String
  uploadedById String
  createdAt    DateTime @default(now())

  case       Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([caseId])
}

model HomeVisit {
  id                 String      @id @default(cuid())
  childId            String
  scheduledDate      DateTime
  purpose            String
  status             VisitStatus @default(PLANNED)
  // Checklist kelayakan rumah (diisi saat kunjungan selesai)
  sanitationOk       Boolean?
  safetyOk           Boolean?
  cleanWaterOk       Boolean?
  childSpaceOk       Boolean?
  foodSecurityOk     Boolean?
  vulnerabilityScore Int?
  visitNotes         String?
  photoUrl           String?
  completedAt        DateTime?
  // Petugas yang ditugaskan/melakukan kunjungan
  officerId          String?
  createdById        String
  createdAt          DateTime    @default(now())

  child     Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdBy User  @relation("VisitCreator", fields: [createdById], references: [id])
  officer   User? @relation("VisitOfficer", fields: [officerId], references: [id])

  @@index([childId])
  @@index([status])
  @@index([scheduledDate])
}

model ShiftHandover {
  id                String    @id @default(cuid())
  date              DateTime
  shift             ShiftType
  allChildrenSafe   Boolean
  sickChildrenNotes String?
  importantNotes    String
  createdById       String
  createdAt         DateTime  @default(now())

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([date])
}

model Incident {
  id           String          @id @default(cuid())
  childId      String
  incidentType IncidentType
  description  String
  handling     String?
  urgency      IncidentUrgency @default(MEDIUM)
  status       IncidentStatus  @default(OPEN)
  photoUrl     String?
  reportedById String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  child      Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  reportedBy User             @relation(fields: [reportedById], references: [id])
  updates    IncidentUpdate[]

  @@index([childId])
  @@index([status])
}

model IncidentUpdate {
  id          String          @id @default(cuid())
  incidentId  String
  notes       String
  newStatus   IncidentStatus?
  createdById String
  createdAt   DateTime        @default(now())

  incident  Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([incidentId])
}

model FinanceCategory {
  id            String   @id @default(cuid())
  name          String   @unique
  monthlyBudget Decimal  @default(0)
  createdAt     DateTime @default(now())

  transactions Transaction[]
}

model Transaction {
  id          String          @id @default(cuid())
  date        DateTime        @default(now())
  description String
  categoryId  String
  type        TransactionType
  amount      Decimal
  proofUrl    String?
  donationId  String?         @unique
  createdById String
  createdAt   DateTime        @default(now())

  category  FinanceCategory @relation(fields: [categoryId], references: [id])
  createdBy User            @relation(fields: [createdById], references: [id])

  @@index([date])
  @@index([categoryId])
  @@index([type])
}

// ================= MODUL KEUANGAN LANJUTAN =================

enum ProgramField {
  PENDIDIKAN
  KESEHATAN
  SOSIAL_LOGISTIK
  INFRASTRUKTUR
  KEAGAMAAN
}

enum ProgramStatus {
  DRAFT
  AKTIF
  PENYALURAN
  SELESAI
  DITANGGUHKAN
}

enum LeftoverRule {
  KE_OPERASIONAL
  KE_PROGRAM_LAIN
}

enum DonorCategory {
  PERORANGAN
  KORPORAT
  PEMERINTAH
  UNIT_BISNIS
  LAINNYA
}

enum FundRestriction {
  TIDAK_TERIKAT
  TERIKAT_TEMPORER
  TERIKAT_PERMANEN
}

enum IncomeFundCategory {
  ZAKAT_MAAL
  ZAKAT_FITRAH
  INFAQ_SEDEKAH
  WAKAF_TUNAI
  WAKAF_ASET
  QURBAN
  HIBAH_TERIKAT
  PENDAPATAN_USAHA
}

enum IncomeMethod {
  TRANSFER_BANK
  TUNAI
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ExpensePocket {
  TIDAK_TERIKAT
  TERIKAT
}

enum ExpenseCoa {
  BEBAN_PROGRAM
  BEBAN_GAJI
  BEBAN_RUMAH_TANGGA
  BEBAN_KANTOR
  BEBAN_FUNDRAISING
}

enum ApprovalStatus {
  DRAFT
  REVIEW
  APPROVAL
  SELESAI
}

// Program penggalangan/penyaluran dana yayasan
model Program {
  id                String        @id @default(cuid())
  code              String        @unique
  name              String
  field             ProgramField
  fundraisingTarget Float         @default(0)
  maxBudget         Float         @default(0)
  startDate         DateTime?
  picId             String?
  status            ProgramStatus @default(DRAFT)
  leftoverRule      LeftoverRule  @default(KE_OPERASIONAL)
  description       String?
  proposalUrl       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  pic      User?            @relation("ProgramPic", fields: [picId], references: [id], onDelete: SetNull)
  incomes  FinanceIncome[]
  expenses FinanceExpense[]

  @@index([status])
}

// Profil donatur / sumber dana
model Donor {
  id            String          @id @default(cuid())
  name          String
  category      DonorCategory   @default(PERORANGAN)
  address       String?
  phone         String?
  email         String?
  dob           DateTime?
  donorSince    DateTime?
  occupation    String?
  monthlyIncome Float?
  lastEducation EducationLevel?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  incomes FinanceIncome[]

  @@index([name])
}

// Rekening kas/bank yayasan
model CashAccount {
  id             String   @id @default(cuid())
  name           String   @unique
  isActive       Boolean  @default(true)
  openingBalance Float    @default(0)
  createdAt      DateTime @default(now())

  incomes  FinanceIncome[]
  expenses FinanceExpense[]
}

// Kas masuk (pemasukan/debit)
model FinanceIncome {
  id              String             @id @default(cuid())
  refNumber       String             @unique
  date            DateTime
  contactCategory DonorCategory      @default(PERORANGAN)
  donorId         String?
  sourceName      String
  restriction     FundRestriction    @default(TIDAK_TERIKAT)
  fundCategory    IncomeFundCategory
  programId       String?
  method          IncomeMethod       @default(TUNAI)
  amount          Float
  verification    VerificationStatus @default(PENDING)
  accountId       String?
  memo            String?
  createdById     String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  donor     Donor?       @relation(fields: [donorId], references: [id], onDelete: SetNull)
  program   Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  account   CashAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy User         @relation("IncomeCreator", fields: [createdById], references: [id])

  @@index([date])
  @@index([verification])
  @@index([programId])
}

// Kas keluar (pengeluaran/kredit) dengan approval workflow
model FinanceExpense {
  id                 String         @id @default(cuid())
  voucherNumber      String         @unique
  date               DateTime
  accountId          String
  pocket             ExpensePocket  @default(TIDAK_TERIKAT)
  programId          String?
  coa                ExpenseCoa
  beneficiaryChildId String?
  beneficiaryName    String?
  amount             Float
  proofUrl           String?
  approval           ApprovalStatus @default(DRAFT)
  createdById        String
  reviewedById       String?
  approvedById       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  account          CashAccount @relation(fields: [accountId], references: [id])
  program          Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)
  beneficiaryChild Child?      @relation(fields: [beneficiaryChildId], references: [id], onDelete: SetNull)
  createdBy        User        @relation("ExpenseCreator", fields: [createdById], references: [id])
  reviewedBy       User?       @relation("ExpenseReviewer", fields: [reviewedById], references: [id])
  approvedBy       User?       @relation("ExpenseApprover", fields: [approvedById], references: [id])

  @@index([date])
  @@index([approval])
  @@index([programId])
}

model StockAdjustment {
  id          String   @id @default(cuid())
  inventoryId String
  delta       Int
  reason      String
  createdById String
  createdAt   DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([inventoryId])
  @@index([createdAt])
}

model PurchaseRequest {
  id            String   @id @default(cuid())
  inventoryId   String
  quantity      Int
  notes         String?
  status        PRStatus @default(PENDING)
  requestedById String
  decidedById   String?
  decisionNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  requestedBy User      @relation("RequestedPRs", fields: [requestedById], references: [id])
  decidedBy   User?     @relation("DecidedPRs", fields: [decidedById], references: [id])

  @@index([status])
  @@index([createdAt])
}

model Asset {
  id              String         @id @default(cuid())
  name            String
  category        AssetCategory  @default(LAINNYA)
  acquisitionDate DateTime
  value           Decimal        @default(0)
  location        String?
  condition       AssetCondition @default(BAIK)
  createdAt       DateTime       @default(now())

  maintenances AssetMaintenance[]

  @@index([category])
}

model AssetMaintenance {
  id              String    @id @default(cuid())
  assetId         String
  maintenanceDate DateTime
  maintenanceType String
  notes           String?
  completedAt     DateTime?
  createdById     String
  createdAt       DateTime  @default(now())

  asset     Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([assetId])
  @@index([maintenanceDate])
}

model DonationPledge {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  amount    Decimal
  purpose   String
  method    String
  message   String?
  followedUp Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  link        String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}
