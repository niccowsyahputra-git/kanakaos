# Turso / libSQL Database
# Local SQLite: file:/absolute/path/to/dev.db
# Turso: libsql://your-db-name.turso.io
DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# NextAuth
AUTH_SECRET="your-random-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Legacy Cloudinary readers only; new uploads use private Google Drive storage.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Server-only Drive credentials created by npm run storage:authorize.
# Do not prefix these variables with NEXT_PUBLIC_ or paste real values into Git.
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""
STORAGE_SIGNING_SECRET=""
